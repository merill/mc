  "Title": "Generally available: Azure SQL Database storage limits increase for selected compute sizes",
  "Source": "azure",
  "Category": "azure",
  "Severity": "normal",
  "IsMajorChange": false,
  "StartDateTime": "2022-04-27T18:00:11.000Z",
