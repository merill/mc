  "Body": {
    "ContentType": "html",
    "Content": "<div><p><span>Azure Functions support for Node.js 22 is now Generally Available. You\ncan now develop functions using Node.js 22 locally and deploy them to all Azure\nFunctions plans on Linux and Windows.</span></p><p><span><a href=\"https://learn.microsoft.com/en-us/azure/azure-functions/update-language-versions?tabs=azure-portal%2Cwindows&amp;pivots=programming-language-javascript\" target=\"_blank\" rel=\"noopener\">Learn more</a>.&nbsp;</span></p></div>",
    "Markdown": "Azure Functions support for Node.js 22 is now Generally Available. You\n\ncan now develop functions using Node.js 22 locally and deploy them to all Azure\n\nFunctions plans on Linux and Windows.\n\nLearn more ."
  },
