  "Body": {
    "ContentType": "html",
    "Content": "<p>Power BI Embedded is integrated with <a href=\"https://docs.microsoft.com/en-us/azure/service-health/resource-health-overview\" target=\"_blank\" rel=\"noopener\">Azure Resource Health</a> monitoring.&nbsp;Resource Health helps you monitor the availability of your resource and diagnose the root cause in case of unavailable status. Any status change will be reported in real time. <a href=\"https://powerbi.microsoft.com/en-us/blog/power-bi-developer-community-november-update-2018/#azure-health\" target=\"_blank\" rel=\"noopener\">Learn more</a>.<a href=\"https://powerbi.microsoft.com/en-us/blog/power-bi-developer-community-november-update-2018/#azure-health\" target=\"_blank\" rel=\"noopener\">&nbsp;</a></p>\r\n",
    "Markdown": "Power BI Embedded is integrated with Azure Resource Health monitoring. Resource Health helps you monitor the availability of your resource and diagnose the root cause in case of unavailable status. Any status change will be reported in real time. Learn more ."
  },
