  "Id": "AZ-azure-sql-database-managed-instance-database-rename-is-supported",
  "Title": "Database rename is now supported in Azure SQL Database Managed Instance",
  "Source": "azure",
  "Category": "azure",
  "Severity": "normal",
  "IsMajorChange": false,
  "StartDateTime": "2019-02-26T19:28:12.000Z",
