  "Body": {
    "ContentType": "html",
    "Content": "<p><a href=\"https://learn.microsoft.com/en-us/azure/storage/files/files-nfs-protocol\" target=\"_blank\" rel=\"noopener\">NFS</a>&nbsp;support is now available for App Service Linux code and container when mounting a&nbsp;Azure File share as a local share for the web app.&nbsp;</p>\r\n\r\n<p>Please refer to&nbsp;<a href=\"https://learn.microsoft.com/en-us/azure/app-service/configure-connect-to-azure-storage?tabs=basic%2Cportal&amp;pivots=container-linux\" target=\"_blank\" rel=\"noopener\">Mount Azure Storage as a local share - Azure App Service</a>&nbsp;for more details.</p>\r\n\r\n<p>&nbsp;</p>\r\n",
    "Markdown": "NFS support is now available for App Service Linux code and container when mounting a Azure File share as a local share for the web app.\n\nPlease refer to Mount Azure Storage as a local share - Azure App Service for more details."
  },
